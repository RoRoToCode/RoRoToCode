{
  "name": "roroto-code",
  "version": "0.1.3",
  "private": true,
  "description": "A minimal Windows coding agent with local and online model support",
  "license": "MIT",
  "author": "RoRoToCode",
  "main": "dist/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && npm run build:main && cross-env PICODEV=1 electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "icon": "node scripts/make-icon.mjs",
    "build": "npm run icon && npm run build:main && npm run build:renderer",
    "test": "npm run build:main && node --test tests/approval.test.cjs tests/risk.test.cjs tests/env.test.cjs tests/redact.test.cjs tests/pricing.test.cjs tests/turns.test.cjs tests/instructions.test.cjs tests/permissions.test.cjs tests/permissions-merge.test.cjs tests/applypatch.test.cjs tests/checkpoint.test.cjs tests/eventbuf.test.cjs tests/cron.test.cjs tests/handoff.test.cjs tests/runqueue.test.cjs tests/roster.test.cjs tests/board.test.cjs tests/quota.test.cjs tests/abort.test.cjs tests/distill.test.cjs tests/toolargs.test.cjs tests/diagnostics.test.cjs tests/streamerror.test.cjs tests/degenerate.test.cjs tests/lspnav.test.cjs tests/newtools.test.cjs tests/p1.test.cjs tests/gpuplan.test.cjs tests/gpuprofile.test.cjs tests/resume.test.cjs tests/p2.test.cjs tests/promptcache.test.cjs tests/mdblocks.test.cjs tests/resultfiles.test.cjs tests/artifacts.test.cjs tests/skilldeps.test.cjs tests/sessionprune.test.cjs tests/msgwindow.test.cjs tests/toolguard.test.cjs tests/sessionhit.test.cjs tests/diagnosegap.test.cjs tests/fixes.test.cjs tests/ctxtune.test.cjs tests/ctxprobe.test.cjs tests/offload.test.cjs tests/idleunload.test.cjs tests/localmodels.test.cjs tests/ollamadir.test.cjs tests/datadir.test.cjs",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "start": "npm run build && electron .",
    "smoke": "npm run build:main && electron dist/main/smoke.js",
    "smoke:daemon": "npm run build:main && electron dist/main/smoke-daemon.js",
    "smoke:gate": "npm run build:main && node dist/main/smoke-gate.js",
    "smoke:ollama": "npm run build:main && node dist/main/smoke-ollama.js",
    "smoke:local": "npm run build:main && electron dist/main/smoke-local.js",
    "smoke:mcp-oauth": "npm run build:main && electron dist/main/smoke-mcp-oauth.js",
    "smoke:routines": "npm run build:main && electron dist/main/smoke-routines.js",
    "smoke:handoff": "npm run build:main && electron dist/main/smoke-handoff.js",
    "smoke:handoff-e2e": "npm run build:main && electron dist/main/smoke-handoff-e2e.js",
    "smoke:running": "npm run build:main && electron dist/main/smoke-running.js",
    "smoke:quota": "npm run build:main && electron dist/main/smoke-quota.js",
    "smoke:steer": "npm run build:main && electron dist/main/smoke-steer.js",
    "smoke:abort": "npm run build:main && electron dist/main/smoke-abort.js",
    "smoke:session": "npm run build:main && electron dist/main/smoke-session.js",
    "dist": "node scripts/pack-portable.mjs",
    "dist:nobuild": "node scripts/pack-portable.mjs --skip-build",
    "dist:raw": "npm run build && electron-builder --win portable",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.json --noEmit",
    "smoke:toolargs": "npm run build:main && electron dist/main/smoke-toolargs.js",
    "smoke:diagnostics": "npm run build:main && electron dist/main/smoke-diagnostics.js",
    "smoke:diaggap": "npm run build:main && electron dist/main/smoke-diaggap.js",
    "smoke:repeat": "npm run build:main && electron dist/main/smoke-repeat.js",
    "smoke:slots": "npm run build:main && electron dist/main/smoke-slots.js",
    "smoke:realmodel": "npm run build:main && electron dist/main/smoke-realmodel.js",
    "smoke:lspnav": "npm run build:main && electron dist/main/smoke-lspnav.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "smoke:idle": "npm run build:main && electron dist/main/smoke-idle.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "phaser": "^4.2.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.rorotocode.app",
    "productName": "RoRoTo Code",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "!dist/main/smoke*.js",
      "dist/shared/**/*",
      "dist/preload.js",
      "dist/renderer/**/*",
      "build/*.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools/vramfit",
        "to": "vramfit",
        "filter": [
          "check.mjs",
          "core/**/*",
          "net/**/*",
          "cli/**/*",
          "package.json",
          "LICENSE",
          "README.md"
        ]
      }
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "RoRoToCode-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "RoRoToCode-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "compression": "maximum"
  }
}
