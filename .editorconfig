root = true

# 与 .gitattributes 保持一致：文本文件统一 LF，Windows 脚本用 CRLF。
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf

[*.md]
# Markdown 里行尾两个空格是有意义的换行，不要自动删
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
